    <div class="row panel-fix">
        <div class="col-md-12">
            <h4><?php $this->_('Opensrs.tab_dns.title'); ?></h4>

            <?php if (!empty($records)) { ?>
            <div class="table-responsive">
                <table class="table table-curved table-striped">
                    <thead>
                        <tr>
                            <th><?php $this->_('Opensrs.tab_dns.field_type'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_subdomain'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_value'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_priority'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_weight'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_port'); ?></th>
                            <th><?php $this->_('Opensrs.tab_dns.field_ttl'); ?></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($records as $record) { ?>
                        <tr>
                            <td><?php echo $this->Html->safe($record['record_type'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['subdomain'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['value'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['priority'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['weight'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['port'] ?? ''); ?></td>
                            <td><?php echo $this->Html->safe($record['ttl'] ?? ''); ?></td>
                            <td>
                                <?php
                                $this->Form->create();
                                $this->Form->fieldHidden('action', 'delete_record');
                                $this->Form->fieldHidden('record_type', $record['record_type'] ?? '');
                                $this->Form->fieldHidden('record_index', $record['record_index'] ?? '');
                                ?>
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> <?php $this->_('Opensrs.tab_dns.field_delete'); ?>
                                </button>
                                <?php $this->Form->end(); ?>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
            <?php } else { ?>
            <div class="alert alert-info">
                <?php ($zone_enabled ?? false)
                    ? $this->_('Opensrs.tab_dns.no_records')
                    : $this->_('Opensrs.tab_dns.no_zone'); ?>
            </div>
            <?php } ?>

            <?php if (!($zone_enabled ?? false)) { ?>
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'enable_dns');
            ?>
            <button class="btn btn-light" type="submit">
                <i class="fas fa-plus"></i> <?php $this->_('Opensrs.tab_dns.field_enable_dns'); ?>
            </button>
            <?php $this->Form->end(); ?>
            <?php } else { ?>

            <h4 class="mt-4"><?php $this->_('Opensrs.tab_dns.add_record'); ?></h4>
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'add_record');
            ?>
            <div class="form-group">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_type', true), 'type');
                $this->Form->fieldSelect(
                    'type',
                    ($record_types ?? []),
                    ($vars->type ?? 'A'),
                    ['id' => 'type', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_subdomain', true), 'subdomain');
                $this->Form->fieldText(
                    'subdomain',
                    ($vars->subdomain ?? null),
                    ['id' => 'subdomain', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-ip_address">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_ip_address', true), 'ip_address');
                $this->Form->fieldText(
                    'ip_address',
                    ($vars->ip_address ?? null),
                    ['id' => 'ip_address', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-ipv6_address">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_ipv6_address', true), 'ipv6_address');
                $this->Form->fieldText(
                    'ipv6_address',
                    ($vars->ipv6_address ?? null),
                    ['id' => 'ipv6_address', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-hostname">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_hostname', true), 'hostname');
                $this->Form->fieldText(
                    'hostname',
                    ($vars->hostname ?? null),
                    ['id' => 'hostname', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-text">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_text', true), 'text');
                $this->Form->fieldText(
                    'text',
                    ($vars->text ?? null),
                    ['id' => 'text', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-priority">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_priority', true), 'priority');
                $this->Form->fieldText(
                    'priority',
                    ($vars->priority ?? null),
                    ['id' => 'priority', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-weight">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_weight', true), 'weight');
                $this->Form->fieldText(
                    'weight',
                    ($vars->weight ?? null),
                    ['id' => 'weight', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group" id="field-port">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_port', true), 'port');
                $this->Form->fieldText(
                    'port',
                    ($vars->port ?? null),
                    ['id' => 'port', 'class' => 'form-control'],
                );
                ?>
            </div>
            <div class="form-group">
                <?php
                $this->Form->label($this->_('Opensrs.tab_dns.field_ttl', true), 'ttl');
                $this->Form->fieldText('ttl', ($vars->ttl ?? '3600'), ['id' => 'ttl', 'class' => 'form-control']);
                ?>
            </div>
            <button class="btn btn-light float-right" type="submit">
                <i class="fas fa-plus"></i> <?php $this->_('Opensrs.tab_dns.field_add'); ?>
            </button>
            <div class="clearfix"></div>
            <?php $this->Form->end(); ?>

            <hr>

            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'reset_zone');
            ?>
            <button class="btn btn-danger" type="submit">
                <i class="fas fa-undo"></i> <?php $this->_('Opensrs.tab_dns.field_reset'); ?>
            </button>
            <?php $this->Form->end(); ?>
            <?php } ?>
        </div>
    </div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        var typeSelect = document.getElementById('type');
        var fieldsByType = {
            'A': ['field-ip_address'],
            'AAAA': ['field-ipv6_address'],
            'CNAME': ['field-hostname'],
            'MX': ['field-hostname', 'field-priority'],
            'SRV': ['field-hostname', 'field-priority', 'field-weight', 'field-port'],
            'TXT': ['field-text']
        };
        var allFieldIds = ['field-ip_address', 'field-ipv6_address', 'field-hostname', 'field-text', 'field-priority', 'field-weight', 'field-port'];

        function updateFields() {
            var visible = fieldsByType[typeSelect.value] || [];
            allFieldIds.forEach(function (id) {
                var el = document.getElementById(id);
                if (el) {
                    el.style.display = visible.indexOf(id) !== -1 ? '' : 'none';
                }
            });
        }

        if (typeSelect) {
            typeSelect.addEventListener('change', updateFields);
            updateFields();
        }
    });
</script>
