<?php /** @var View $this **/ ?>

<?php if (!empty($ds_records)) { ?>
<div class="table-responsive mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Opensrs.tab_dnssec.field_key_tag'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dnssec.field_algorithm'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dnssec.field_digest_type'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dnssec.field_digest'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dnssec.field_options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($ds_records as $record) { ?>
            <tr>
                <td><?php echo $this->Html->safe($record['key_tag'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['algorithm'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['digest_type'] ?? ''); ?></td>
                <td><code><?php echo $this->Html->safe(
                    substr($record['digest'] ?? '', 0, 32)
                        . (strlen($record['digest'] ?? '') > 32 ? '...' : ''),
                ); ?></code></td>
                <td>
                    <?php
                    $this->Form->create(null, ['class' => 'd-inline']);
                    $this->Form->fieldHidden('action', 'delete_ds_record');
                    $this->Form->fieldHidden('record_index', $record['record_index'] ?? '');
                    ?>
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="<?php $this->_(
                        'Opensrs.tab_dnssec.field_delete',
                    ); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="card-body text-center text-muted py-5 mb-3">
    <i class="bi bi-shield-lock" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('Opensrs.tab_dnssec.no_records'); ?></p>
</div>
<?php } ?>

<h5><?php $this->_('Opensrs.tab_dnssec.add_record'); ?></h5>
<?php $this->Form->create(); ?>
<?php $this->Form->fieldHidden('action', 'add_ds_record'); ?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dnssec.field_key_tag', true), 'key_tag', ['class' => 'form-label']);
    $this->Form->fieldText('key_tag', ($vars->key_tag ?? null), ['id' => 'key_tag', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dnssec.field_algorithm', true), 'algorithm', ['class' => 'form-label']);
    $this->Form->fieldSelect(
        'algorithm',
        ($algorithms ?? []),
        ($vars->algorithm ?? '8'),
        ['id' => 'algorithm', 'class' => 'form-select'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label(
        $this->_('Opensrs.tab_dnssec.field_digest_type', true),
        'digest_type',
        ['class' => 'form-label'],
    );
    $this->Form->fieldSelect(
        'digest_type',
        ($digest_types ?? []),
        ($vars->digest_type ?? '2'),
        ['id' => 'digest_type', 'class' => 'form-select'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dnssec.field_digest', true), 'digest', ['class' => 'form-label']);
    $this->Form->fieldText('digest', ($vars->digest ?? null), ['id' => 'digest', 'class' => 'form-control']);
    ?>
</div>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Opensrs.tab_dnssec.field_add', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>
<?php $this->Form->end(); ?>
